{
  "name": "qnaphomehub-server",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "5.1.0",
    "node-switchbot": "4.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "@stoprocent/bluetooth-hci-socket": true,
    "@stoprocent/noble": true,
    "@serialport/bindings-cpp": true,
    "usb": true,
    "esbuild": true
  }
}
